<!DOCTYPE html>
<html>
<head>
    <title><%= user.Name %>'s Profile</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .information, .post-card{
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(4px);
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            padding: 20px;
            margin-top: 20px;
            transition: transform 0.2s ease-in-out;
        }

        .information:hover {
            transform: scale(1.40);
        }

        .post-card:hover {
            transform: scale(1.01);
        }

        .post-card img {
            max-width: 100%;
            border-radius: 12px;
            margin-top: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }
    </style>
</head>

<footer class="bottom-bar">
    Guan-Fu Chen All Rights Reserved © 2025 🄡
</footer>

<body>
<div style="max-width: 600px; margin: auto; padding: 30px;">
    <h2>🧑‍💻 <%= user.Name %>'s Profile</h2>
    <div class="information">
        <img src="/<%= user.ProfilePicture || 'uploads/default-avatar.png' %>" alt="Avatar"
        style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover;">
        <p><strong>Email:</strong> <%= user.Email %></p>
        <p><strong>Phone:</strong> <%= user.PhoneNumber %></p>
        <p><strong>Bio:</strong> <%= user.Bio || '(No bio)' %></p>
    </div>

    <hr>
    <h3>📸 Posts</h3>
    <% if (posts.length === 0) { %>
        <p>This user hasn't posted anything yet.</p>
    <% } else { %>
        <% posts.forEach(post => { %>
            <div class="post-card">
                <p><%= post.Content %></p>
                <% if (post.Media) { %>
                    <img src="/<%= post.Media %>">
                <% } %>
                <p style="font-size: 0.8em; color: #888;"><%= post.Timestamp %></p>
            </div>
        <% }) %>
    <% } %>

    <a href="/home" style="display: inline-block; margin-top: 20px;">🏠 Back to Home</a>
</div>
</body>
</html>
